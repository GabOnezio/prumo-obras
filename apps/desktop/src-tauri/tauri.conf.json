{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prumo",
  "version": "0.0.1",
  "identifier": "io.github.gabonezio.prumo",
  "build": {
    "frontendDist": "../previa"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prumo · Prefeitura de Exemplo (prévia)",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
